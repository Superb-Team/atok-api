# API Configuration
API_KEY=your-api-key-here

# AWS Transcribe & S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-s3-bucket-name

# OpenSearch Configuration
OPENSEARCH_HOST=your-opensearch-host.amazonaws.com
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your-opensearch-password
OPENSEARCH_PORT=443

# AWS Bedrock for RAG (Cohere Embed v4)
# Note: Cohere Embed v4 only available in ap-northeast-1
RAG_AWS_ACCESS_KEY_ID=your-aws-access-key
RAG_AWS_SECRET_ACCESS_KEY=your-aws-secret-key
RAG_AWS_REGION=ap-northeast-1
RAG_COHERE_MODEL_ID=cohere.embed-v4:0

# LLM Configuration (for text enhancement)
# Add your LLM configuration here if needed

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database
